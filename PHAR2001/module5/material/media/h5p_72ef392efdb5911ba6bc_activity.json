                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "chosenFeedback": "<div>Children and the elderly metabolise drugs at a greatly reduced rate, for a variety of reasons.</div>\n",
                    "tip": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Both children and the elderly metabolise analgesics at about the same rate as other humans</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>The dose of analgesics in children is based on mg of drug per kg in child weight and NEVER should be x% of the adult dose</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Aspirin is not to be used in children who have a fever /viral infection because it can (rarely) cause Reye’s syndrome, which is a life threatening \n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Codeine is contraindicated in children younger than 12 because it is generally ineffective and can cause respiratory depression. \n"
                }
