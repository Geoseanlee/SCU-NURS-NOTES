    {
      "title": "PHAR2001_5_7_2_SSRIs_and_TCAs",
      "library": "H5P.QuestionSet 1.21",
      "params": {
        "introPage": {
          "showIntroPage": false,
          "startButtonText": "Start Quiz",
          "introduction": ""
        },
        "progressType": "dots",
        "passPercentage": 50,
        "questions": [
          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "SSRIs include Sertraline (Zoloft), Escitalopram (Lexapro) and Fluoxetine (Prozac) in the top 20 medications most prescribed. \n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "They take 4-6 weeks to be effective\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "They may increase the risk of suicide\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "They are the first line agents in the treatment of major depression\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "No, they very frequently result in sexual dysfunction or at least decreased libido \n",
                    "notChosenFeedback": "Well done, they very frequently result in sexual dysfunction or at least decreased libido \n"
                  },
                  "text": "<div>They generally increase libido</div>\n"
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 100
                }
              ],
              "behaviour": {
