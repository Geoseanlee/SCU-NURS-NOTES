        "progressType": "dots",
        "passPercentage": 50,
        "questions": [
          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "chosenFeedback": "<div>Paracetamol has no anti-inflammatory effects and is only about half as effective at reducing pain as NSAIDs. It does have antipyretic effects.&nbsp;</div>\n",
                    "tip": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Paracetamol has anti-inflammatory effects and is generally about as effective at reducing pain as NSAIDs</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Paracetamol toxicity in the number one cause of acute liver failure in Australia, UK, USA, NZ and Canada. \n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Paracetamol dose should NEVER be increased because the increased dose has no effect on reducing pain, but results in greater side effects. \n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Paracetamol has a very variable half life between clients and is found in many types of medication including cold and flu meds. </div>\n"
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 100
                }
