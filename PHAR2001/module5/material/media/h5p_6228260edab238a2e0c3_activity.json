              "answers": [
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Paracetamol toxicity includes extremely painful acute liver failure</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "There is an antidote for paracetamol toxicity, but there is a very short (two hour) window where the client can be given N-acetylcysteine \n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Paracetamol toxicity only occurs when the person is trying to commit suicide\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Paracetamol toxicity may result in abdominal pain but the alarming thing about paracetamol overdose is that there may not be any symptoms for up to 12 days after ingestion.\n"
                }
              ],
