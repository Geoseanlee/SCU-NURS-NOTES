                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "chosenFeedback": "<div>Good work, this type of peripheral neuropathy is very painful, despite the fact that the person normally has a decreased ability to recognise touch stimuli.&nbsp;</div>\n",
                    "notChosenFeedback": "<div>You should have selected this because this type of peripheral neuropathy is very painful, despite the fact that the person normally has a decreased ability to recognise touch stimuli.&nbsp;</div>\n",
                    "tip": ""
                  },
                  "text": "<div>Alcoholic or diabetic neuropathy</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "chosenFeedback": "<div>Yes, shingles damages nerve endings and leads to chronic neuropathic pain.&nbsp;</div>\n",
                    "notChosenFeedback": "<div>Next time, select this, because shingles damages nerve endings and leads to chronic neuropathic pain.&nbsp;</div>\n",
                    "tip": ""
                  },
                  "text": "<div>The pain after a bout of shingles</div>\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This type of acute pain normally resolves after a short amount of time, while neuropathic pain occurs after long term damage to the nerve endings.&nbsp;</div>\n",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>The throbbing pain after a paper cut.&nbsp;</div>\n"
                }
