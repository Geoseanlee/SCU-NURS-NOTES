          },
          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "chosenFeedback": "NO, This statement is incorrect. The SERMs include Tamoxifen and other …oxifen medications\n",
                    "notChosenFeedback": "Indeed, this statement is incorrect. The SERMs include Tamoxifen and other …oxifen medications\n",
                    "tip": ""
                  },
                  "text": "<div>The SERMs include teriparatide</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Since SERMs antagonise the oestrogen receptors on breast tissues, they have been extensively used on breast cancer patients to decrease progression of oestrogen-linked breast cancer\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "While SERMs antagonise the effects of oestrogen on the breast tissue, they actually have beneficial effects of oestrogen itself at other tissues, like the bone, helping to maintain bone density. \n"
                }
              ],
              "overallFeedback": [
                {
