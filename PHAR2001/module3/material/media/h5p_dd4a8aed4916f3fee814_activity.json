      "title": "PHAR2001_3_6_3_Bisphosphonates_Teriparatide_SERMS",
      "library": "H5P.QuestionSet 1.21",
      "params": {
        "introPage": {
          "showIntroPage": false,
          "startButtonText": "Start Quiz",
          "introduction": ""
        },
        "progressType": "dots",
        "passPercentage": 50,
        "questions": [
          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Oral bisphosphonates are the first line therapy for osteoporosis \n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The bisphosphonates get incorporated into the bone, encouraging the osteoclasts (bone munching cells) to undergo apoptosis (nicknamed ‘cell suicide’)\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The oral bisphosphonates end in the suffix …dronate, for instance alendronate. \n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "chosenFeedback": "NO, this statement is incorrect. Bisphosphonates only decrease the breakdown of bone and have little or no effect on increasing the formation of bone. \n",
                    "notChosenFeedback": "Indeed, this statement is incorrect. Bisphosphonates only decrease the breakdown of bone and have little or no effect on increasing the formation of bone. \n",
                    "tip": ""
                  },
                  "text": "One action of the bisphosphonates is to increase production of the bone\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "One rare adverse effect associated with bisphosphonates include a slight risk of osteonecrosis of the jaw. \n"
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 100
                }
              ],
