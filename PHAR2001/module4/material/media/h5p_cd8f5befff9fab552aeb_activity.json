          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Clopidogrel can be combined with aspirin for additional benefits</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Clopidogrel is the preferred antiplatelet drug over aspirin</div>\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "chosenFeedback": "<div>NO, this is not a correct statement. Clopidogrel is an antiPLATELET drug, and there are very few platelets in venous clots. Anticoagulants are useful in DVTs.&nbsp;</div>\n",
                    "notChosenFeedback": "<div>Indeed, this is not a correct statement. Clopidogrel is an antiPLATELET drug, and there are very few platelets in venous clots. Anticoagulants are useful in DVTs.&nbsp;</div>\n",
                    "tip": ""
                  },
                  "text": "<div>Clopidogrel is proven to reduce the risk of pulmonary embolism from deep vein thrombosis</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>The effects of clopidogrel commence in about two hours after intake and last five days</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Clopidogrel is an ADP receptor antagonist that is fairly selective for the ADP receptor on platelets</div>\n"
                }
              ],
