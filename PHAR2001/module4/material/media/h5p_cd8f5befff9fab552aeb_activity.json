      "title": "PHAR2001_4_3_2_Antiplatelet_Drugs",
      "library": "H5P.QuestionSet 1.21",
      "params": {
        "introPage": {
          "showIntroPage": false,
          "startButtonText": "Start Quiz",
          "introduction": ""
        },
        "progressType": "dots",
        "passPercentage": 50,
        "questions": [
          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Aspirin is indicated in clients with complicated atherosclerotic lesions that could wind up causing myocardial infarction or stroke</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Aspirin is an antiplatelet drug that does not destroy the platelet or render the platelet incapable of aggregating but rather, in effect, takes away one of the platelet's 'tools'</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Aspirin inhibits cyclooxygenase needed to form thromboxane A2 (TXA2) which is a pro-platelet prostaglandin. \n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Low dose aspirin (75-150 mg/day is proven effective in reducing myocardial infarctions and strokes from atherosclerosis. \n"
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 100
                }
              ],
