        "progressType": "dots",
        "passPercentage": 50,
        "questions": [
          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "They decrease the synthesis of cholesterol in the liver\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "They decrease the amount of fatty acids and cholesterol that is absorbed\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "They increase the amount of the good cholesterol protein, the HDL \n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "They are especially good for individuals with familial hypercholesterolaemia, where the liver makes too much cholesterol (the liver almost seems to be 'set' at the wrong cholesterol level in familial hypercholesterolaemia)\n"
                }
              ],
              "overallFeedback": [
