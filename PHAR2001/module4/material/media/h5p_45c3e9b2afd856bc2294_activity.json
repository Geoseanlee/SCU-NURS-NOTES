              "question": "<p>Which of the following is true about the HMG CoA reductase inhibitors?</p>\n"
            },
            "library": "H5P.MultiChoice 1.16",
            "metadata": {
              "contentType": "Multiple Choice",
              "license": "U",
              "title": "Untitled Multiple Choice"
            },
            "subContentId": "93e6c4d1-36fd-4a69-a395-5bb4362e9711"
          },
          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The statins are associated with a decrease in mortality\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The statins are associated with an increase in longevity\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The statins are associated with a significant decrease in atherothrombotic events\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The statins have anti-inflammatory effects\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The statins have antithrombotic effects\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The statins have plaque stabilizing effects\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "chosenFeedback": "NO, THIS STATEMENT IS INCORRECT. The statins are a pregnancy category D drug and should never be taken during pregnancy. \n",
                    "tip": "",
                    "notChosenFeedback": "INDEED, THIS STATEMENT IS INCORRECT. The statins are a pregnancy category D drug and should never be taken during pregnancy. \n"
                  },
                  "text": "The statins are the preferred lipid lowering drug during pregnancy\n"
                }
              ],
