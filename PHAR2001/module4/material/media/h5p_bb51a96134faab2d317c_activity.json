                  },
                  "text": "Loop diuretics include furosemide \n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "Furosemide inhibits the sodium reabsorption at the broad portion of the loop of Henle \n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "chosenFeedback": "NO, this statement is incorrect. The thiazide diuretics like hydrochlorothiazide SAVE calcium and the loop diuretics like furosemide WASTE calcium, potassium, and magnesium\n",
                    "notChosenFeedback": "Indeed, this statement is incorrect. The thiazide diuretics like hydrochlorothiazide SAVE calcium and the loop diuretics like furosemide WASTE calcium, potassium, and magnesium\n",
                    "tip": ""
                  },
                  "text": "Furosemide is the preferred diuretic for those with osteoporosis\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "chosenFeedback": "This statement was correct, loop diuretics can result in deficiencies in potassium, calcium and magnesium. \n",
                    "notChosenFeedback": "Indeed, loop diuretics can result in deficiencies in potassium, calcium and magnesium. \n",
                    "tip": ""
                  },
                  "text": "Electrolyte levels should be periodically taken when a person is on furosemide or other loop diuretics\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "chosenFeedback": "This statement is incorrect. Both loop diuretics and thiazide diuretics increase uric acid levels\n",
                    "tip": "",
                    "notChosenFeedback": "Indeed, this statement is incorrect. Both loop diuretics and thiazide diuretics increase uric acid levels\n"
                  },
                  "text": "Loop diuretics like furosemide are the preferred medication for those with gout\n"
                }
