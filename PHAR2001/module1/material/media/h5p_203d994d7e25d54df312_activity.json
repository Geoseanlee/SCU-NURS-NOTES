              "answers": [
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "The phase 1 reactions involve cytochrome P450 enzymes that make\nthe drug more hydrophilic or water loving and gives the liver an additional\ntarget to come back to in the Phase 2 reaction.&nbsp;"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>No,&nbsp;phase 2 reactions in the liver add a polar group to the drug to make it very water soluble and easier to excrete. The drug may still be active but the main point is to make it water soluble.&nbsp;</div>\n",
                    "notChosenFeedback": "<div>Indeed,&nbsp;phase 2 reactions in the liver add a polar group to the drug to make it very water soluble and easier to excrete. The drug may still be active but the main point is to make it water soluble.&nbsp;</div>\n"
                  },
                  "text": "The phase 2 reaction destroys the drug. \n"
                }
              ],
