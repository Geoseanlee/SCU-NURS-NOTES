                  },
                  "text": "<div>Magnesium Hydroxide (or citrate)</div>\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Aluminium Hydroxide (or citrate)</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Sodium Bicarbonate</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "chosenFeedback": "<div>Indeed, Calcium based antacids are absorbed but also BIND to many nutrients and drugs and result in the greatest REBOUND hyperacidity&nbsp;</div>\n",
                    "tip": "",
                    "notChosenFeedback": "<div>Your answer was incorrect. Calcium based antacids are not only absorbed but also BIND to many nutrients and drugs and result in the greatest REBOUND hyperacidity&nbsp;</div>\n"
                  },
                  "text": "<div>Calcium carbonate</div>\n"
                }
