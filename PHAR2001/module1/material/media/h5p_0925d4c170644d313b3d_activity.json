          {
            "params": {
              "media": {
                "disableImageZooming": false
              },
              "answers": [
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Drugs that can decrease the tone of the lower oesophageal sphincter including benzodiazepines, alcohol, and opioids</div>\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Binge eating or central obesity, as that pushes the contents of the stomach towards the lower oesophageal sphincter.&nbsp;</div>\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Genetic predisposition (those with a weaker lower oesophageal sphincter)&nbsp;</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>(All of the options can lead to gastroesophageal reflux disease)&nbsp;</div>\n"
                }
              ],
