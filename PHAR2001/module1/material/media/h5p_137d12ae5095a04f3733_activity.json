                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Dry mouth and mucus membranes</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Decreased skin turgor (the elastic spring-back of the skin)</div>\n"
                },
                {
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "",
                    "notChosenFeedback": ""
                  },
                  "text": "<div>Dark yellow, strong smelling urine</div>\n"
                },
                {
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Infants actually have sunken eyes when dehydrated.&nbsp;</div>\n",
                    "notChosenFeedback": "<div>Yes, infants have sunden eyes when dehydrated.&nbsp;</div>\n"
                  },
                  "text": "<div>Profound eyes in an infant</div>\n"
